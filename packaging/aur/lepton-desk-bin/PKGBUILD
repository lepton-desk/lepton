# Maintainer: Lepton <lepton-framework@protonmail.com>

pkgname=lepton-desk-bin
pkgver=0.1.8
pkgrel=2
pkgdesc="Desktop app framework with a Zig core and a web frontend on WPE WebKit (prebuilt CLI)"
arch=('x86_64')
url="https://github.com/lepton-desk/lepton"
license=('MIT OR Apache-2.0')
# The CLI builds each application's Zig core and probes libraries with pkg-config.
# From 0.1.9 the CLI builds with Zig 0.16 and 0.17 and finds `zig` on PATH itself
# (crates/orchestrator/src/zig.rs), so Arch's own `zig` (0.17) is enough. 0.1.8 and older
# built with 0.16 only and needed the AUR's zig0.16 and a wrapper; these recipes are for
# 0.1.9 and later. zig, pkgconf and wpewebkit are run or built against, not linked, so
# namcap reports them as possibly unneeded; they are needed.
depends=('glibc' 'libgcc' 'zig' 'pkgconf' 'wpewebkit>=2.54')
optdepends=(
  'nodejs: frontend builds for npm, pnpm and Yarn projects'
  'pnpm: the default package manager when installed'
  'bun: Bun projects'
  'cairo: text on the native (no web engine) render path'
  'mesa: GPU presentation on the native render path'
  'harfbuzz: GPU text on the native render path'
)
provides=('lepton-desk')
# Installed as /usr/bin/lepton-desk: Dropbox's JPEG compressor is packaged as `lepton` and
# owns /usr/bin/lepton, so both can be installed side by side. Inside a project the
# `"lepton"` script runs the CLI from the project's own node_modules, not this one.
conflicts=('lepton-desk')
# The binary is published to npm as the CLI's platform package; it is the same file
# `npm install @lepton-desk/cli` runs.
source=("cli-linux-x64-${pkgver}.tgz::https://registry.npmjs.org/@lepton-desk/cli-linux-x64/-/cli-linux-x64-${pkgver}.tgz")
# npm's own integrity for this tarball (sha512), from `npm view @lepton-desk/cli-linux-x64@<pkgver>
# dist.integrity`; `node tools/release-version.mjs aur` writes it after each release.
sha512sums=('4575775f9c9c716b8eb22f1e97bf505b6d06cf5e60bef20b3cb91002ea05e589ea35405cd1ea048c7bd1f4c6c0489dcb3e200a2a91279cbfed1ac8ab4a3efa3f')
options=('!strip' '!debug')

package() {
  install -Dm755 package/bin/lepton "$pkgdir/usr/bin/lepton-desk"
  install -Dm644 package/LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 package/LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
